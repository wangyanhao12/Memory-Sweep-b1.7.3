{
  "schemaVersion": 1,
  "id": "memorysweep",
  "version": "${version}",

  "name": "MemorySweep",
  "description": "自动清理内存的模组:支持定时清理与基于内存使用率的智能清理;另外提供一个客户端快捷键(默认 J)用于手动触发清理(仅本地/单人生效)。",
  "authors": [
    "Your Name"
  ],
  "contact": {
  },

  "license": "MIT",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "com.memorysweep.MemorySweepMod"
    ],
    "stationapi:event_bus_client": [
      "com.memorysweep.KeybindListener"
    ],
    "stationapi:event_bus_server": [
      "com.memorysweep.MemoryCleanupListener"
    ]
  },

  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "fabricloader": ">=0.19.3",
    "stationapi": "*"
  }
}
